# start.sh が読み込む待ち受け設定。使う場合は .env にコピーする。
# 外部の端末からアクセスさせる場合は HOST=0.0.0.0 に変更する。
HOST=127.0.0.1
PORT=8000

# --- MCP ---
# 認証キー。未設定なら data/mcp_api_key に自動生成して使い回す。
# MCP_API_KEY=
# 自動生成したキーの保存先を変える場合に指定する。
# MCP_API_KEY_FILE=
# MCP エンドポイントのパス（既定は /mcp）。
# MCP_MOUNT_PATH=/mcp
# MCP クライアントに見せるサーバー名（既定は todo-app）。
# MCP_SERVER_NAME=todo-app
# HOST=0.0.0.0 で外部から MCP に繋ぐ場合、その Host 名をカンマ区切りで許可する。
# 未設定だと DNS リバインディング対策により localhost 以外は 421 で拒否される。
# MCP_ALLOWED_HOSTS=todo.example.com,192.168.1.10:8000
