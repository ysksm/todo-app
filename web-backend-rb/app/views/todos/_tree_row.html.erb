<%# ツリーを 1 行 = 1 TODO の表として描画する。depth で控えめにインデントする。 %>
<tr class="tree-row <%= "is-done" if todo.done? %>">
  <td class="tree-table-toggle">
    <% toggle_label = todo.done? ? "「#{todo.title}」を未着手に戻す" : "「#{todo.title}」を完了にする" %>
    <%= button_to "✓", toggle_todo_path(todo), method: :patch,
          class: "toggle #{'toggled' if todo.done?}",
          title: toggle_label, "aria-label": toggle_label, "aria-pressed": todo.done? %>
  </td>
  <td><span class="type-badge type-<%= todo.todo_type %>"><%= todo_type_label(todo.todo_type) %></span></td>
  <td>
    <span class="tree-indent" style="padding-left: <%= depth * 1.25 %>rem;">
      <% if depth.positive? %><span class="tree-marker">└</span><% end %>
      <%= link_to todo.title, todo_path(todo), class: "todo-title" %>
    </span>
  </td>
  <td>
    <% if todo.priority != "medium" %>
      <span class="priority-badge priority-<%= todo.priority %>"><%= todo_priority_label(todo.priority) %></span>
    <% else %>
      <span class="muted"><%= todo_priority_label(todo.priority) %></span>
    <% end %>
  </td>
  <td>
    <% if todo.target_date %>
      <span class="due-date <%= 'is-overdue' if todo.target_date < Date.current && !todo.done? %>"><%= format_target_date(todo.target_date) %></span>
    <% else %>
      <span class="muted">-</span>
    <% end %>
  </td>
  <td><span class="status status-<%= todo.status %>"><%= todo_status_label(todo.status) %></span></td>
  <td>
    <span class="actions">
      <% unless todo.allowed_child_types.empty? %>
        <%= link_to "＋子", new_todo_path(parent_id: todo.id), title: "子を追加" %>
      <% end %>
      <%= link_to "ブラウズ", browse_todo_path(todo), title: "ブラウズで掘り下げる" %>
      <%= link_to "マップ", mindmap_path(todo), title: "このチケットのマインドマップ" %>
      <%= link_to "編集", edit_todo_path(todo) %>
      <%= button_to "削除", todo_path(todo), method: :delete, class: "link-danger",
            form: { data: { turbo_confirm: "「#{todo.title}」と子孫をすべて削除します。よろしいですか？" } } %>
    </span>
  </td>
</tr>
<% todo.children.each do |child| %>
  <%= render "todos/tree_row", todo: child, depth: depth + 1 %>
<% end %>
