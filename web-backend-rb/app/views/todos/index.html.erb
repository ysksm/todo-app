<div class="page-header">
  <h1>TODO ツリー</h1>
  <%= link_to "＋ ルートに追加", new_todo_path, class: "btn btn-primary" %>
</div>

<% if @roots.empty? %>
  <p class="empty">まだ TODO がありません。「＋ ルートに追加」から作成してください。</p>
<% else %>
  <div class="table-scroll">
    <table class="tree-table">
      <thead>
        <tr>
          <th class="tree-cell-head">タイトル</th>
          <th>優先度</th>
          <th>目標予定日</th>
          <th>状態</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @roots.each do |root| %>
          <%= render "todos/tree_row", todo: root, depth: 0 %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
