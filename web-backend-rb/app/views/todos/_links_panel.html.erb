<%# 関連・依存リンクの一覧と追加フォーム。todo をローカルとして受け取る。
    フォーム送信後は redirect_back で呼び出し元の画面に留まる。 %>
<%
  depends = todo.outgoing_links.select { |l| l.link_type == "depends_on" }
  depended = todo.incoming_links.select { |l| l.link_type == "depends_on" }
  related_out = todo.outgoing_links.select { |l| l.link_type == "relates_to" }
  related_in = todo.incoming_links.select { |l| l.link_type == "relates_to" }
%>
<% if depends.empty? && depended.empty? && related_out.empty? && related_in.empty? %>
  <p class="empty">リンクはまだありません。</p>
<% else %>
  <ul class="link-list">
    <% depends.each do |link| %>
      <li>
        <span class="link-kind link-depends">依存先</span>
        <%= link_to link.target.title, todo_path(link.target) %>
        <span class="status status-<%= link.target.status %>"><%= todo_status_label(link.target.status) %></span>
        <%= button_to "解除", todo_link_path(todo, link), method: :delete, class: "link-danger" %>
      </li>
    <% end %>
    <% depended.each do |link| %>
      <li>
        <span class="link-kind link-depended">依存されている</span>
        <%= link_to link.source.title, todo_path(link.source) %>
        <%= button_to "解除", todo_link_path(todo, link), method: :delete, class: "link-danger" %>
      </li>
    <% end %>
    <% (related_out + related_in).each do |link| %>
      <% other = link.source_id == todo.id ? link.target : link.source %>
      <li>
        <span class="link-kind link-related">関連</span>
        <%= link_to other.title, todo_path(other) %>
        <%= button_to "解除", todo_link_path(todo, link), method: :delete, class: "link-danger" %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [ todo, TodoLink.new ], url: todo_links_path(todo), class: "link-form" do |f| %>
  <%= f.select :link_type, link_type_options %>
  <%
    candidates = Todo.where.not(id: todo.id).ordered.map do |t|
      [ "#{todo_type_label(t.todo_type)}: #{t.title}", t.id ]
    end
  %>
  <%= f.select :target_id, candidates, { prompt: "リンク先を選択" } %>
  <%= f.submit "リンクを追加", class: "btn" %>
  <p class="hint">「依存」はこの TODO が選択先に依存している（選択先が終わるまで着手できない）ことを表します。</p>
<% end %>
