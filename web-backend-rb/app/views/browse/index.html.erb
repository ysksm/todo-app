<div class="page-header">
  <h1>プロジェクトを選択</h1>
  <div class="page-header-actions">
    <%= render "browse/view_toggle", path_options: { controller: "browse", action: "index" } %>
    <%= link_to "＋ 新規プロジェクト", new_todo_path(return_to: browse_path(view: (@view if @view == "list"))), class: "btn btn-primary" %>
  </div>
</div>

<p class="hint">プロジェクト → エピック → フィーチャー → ユーザーストーリー → タスクの順に掘り下げて内容を落とし込んでいく画面です。</p>

<% if @projects.empty? %>
  <p class="empty">まだプロジェクトがありません。</p>
<% else %>
  <%= render "browse/items", items: @projects %>
<% end %>
