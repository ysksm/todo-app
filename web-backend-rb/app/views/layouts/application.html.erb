<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TODO アプリ (Rails)" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Web Backend Rb">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "TODO アプリ", root_path, class: "site-title" %>
      <nav class="site-nav">
        <%= link_to "ツリー", root_path, class: "nav-link #{'is-active' if current_page?(root_path)}" %>
        <%= link_to "マインドマップ", mindmap_path, class: "nav-link #{'is-active' if current_page?(mindmap_path)}" %>
        <%= link_to "ブラウズ", browse_path, class: "nav-link #{'is-active' if request.path.start_with?('/browse')}" %>
        <%= link_to "作業", work_path, class: "nav-link #{'is-active' if current_page?(work_path)}" %>
        <%= link_to "カレンダー", calendar_path, class: "nav-link #{'is-active' if current_page?(calendar_path)}" %>
      </nav>
    </header>
    <main class="container <%= yield :container_class %>">
      <% flash.each do |kind, message| %>
        <div class="flash flash-<%= kind %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
